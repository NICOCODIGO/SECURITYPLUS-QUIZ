{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-changed-file.mjs"],
            "timeout": 60,
            "statusMessage": "Linting the file just written"
          }
        ]
      }
    ]
  }
}
